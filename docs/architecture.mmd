flowchart LR
    subgraph IMPLEMENTED[Implemented]
        ING[Ingest<br/>validate and decode image or video]
        DET[Detect<br/>model registry, class filter, count]
        REL[Reliability<br/>threshold sweep and model agreement]
        DEC[Decide<br/>needs-review flag]
        REV[Review<br/>blind human correction queue]
        STO[Store<br/>SQLite or PostgreSQL history]
        VID[Video<br/>ByteTrack line-crossing counts]
        BM[Benchmark and evaluation<br/>cached detections and audited labels]
        PRED[Error predictor<br/>offline scene-grouped workflow]
        EXP[Export<br/>JSON and CSV]
        SLC[Sliced inference<br/>tile and merge detections]
    end

    ING --> DET
    DET --> REL
    DET --> SLC
    DET --> BM
    REL --> PRED
    BM --> PRED
    PRED --> DEC
    DEC --> REV
    ING --> STO
    VID --> EXP
    DET --> EXP

    classDef built fill:#16263c,stroke:#f5a623,stroke-width:2px,color:#e9eef5;
    class ING,DET,REL,DEC,REV,STO,VID,BM,PRED,EXP,SLC built;
