# Model weights (downloaded on first use, never committed)
*.pt
*.onnx
*.engine
*.torchscript
*.trt
runs/
# Partial downloads written while a weights file is still transferring
*.part

# Virtual environments
.venv/
venv/
env/
ENV/

# Caches and build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Streamlit
.streamlit/secrets.toml

# Exports produced by the app
exports/
trafficlens_*.json
trafficlens_*.csv

# Generated curation outputs
results/

# Raw footage and collected media (kept out of version control). The curated test set
# images are the deliberate exception: all 45 are versioned so a fresh clone can be
# audited and scored without access to the private archive (overlays stay excluded).
data/testset/clips/*
data/samples/*
!data/testset/images/.gitkeep
!data/testset/clips/.gitkeep
!data/samples/.gitkeep
!data/samples/video/
!data/samples/video/PROVENANCE.csv

# Intermediate test set artifacts, regenerated by the scripts on demand
data/testset/inventory.csv
data/testset/review/
data/testset/LABELS.pass1.bak
data/history.db
data/history.db-shm
data/history.db-wal

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
