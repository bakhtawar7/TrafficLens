# TrafficLens environment configuration
# Copy this file to .env for local development:
#   Windows PowerShell: Copy-Item .env.example .env
# Never commit .env or put real credentials in this file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Current TrafficLens history still uses local SQLite (data/history.db).
# These PostgreSQL URLs are for the planned Neon migration and are not yet
# consumed by the current SQLite history implementation.
# Use Neon pooled URL for app traffic and direct URL for schema migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage
# ---------------------------------------------------------------------------
# Keep the bucket private. Use an API token restricted to this bucket.
# Do not use real access keys in .env.example.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=trafficlens-media
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ---------------------------------------------------------------------------
# Media storage behaviour
# ---------------------------------------------------------------------------
# Cloud storage integration is not enabled in the current app yet.
# Keep disabled until the R2 upload, retention, and privacy workflow is implemented.
MEDIA_STORAGE_ENABLED=false
